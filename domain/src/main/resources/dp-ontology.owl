        <rdfs:comment>This ontology defines concepts and relationships for agile data modeling, including entity types, attributes, and their relationships.</rdfs:comment>
        <imports rdf:resource="http://www.w3.org/2001/sw/BestPractices/OEP/SimplePartWhole/part.owl"/>
    </Ontology>



