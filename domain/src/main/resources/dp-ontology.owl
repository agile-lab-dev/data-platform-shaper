    <Ontology rdf:about="https://w3id.org/agile-dm/ontology/">
        <dc:title>Agile Data Model Ontology</dc:title>
        <dc:description>An ontology for representing agile data models and their relationships.</dc:description>
        <vann:preferredNamespacePrefix>agile-dm</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/agile-dm/ontology/</vann:preferredNamespaceUri>
